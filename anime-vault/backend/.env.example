# 数据库
DATABASE_URL=postgresql://animevault:animevault@localhost:5432/animevault

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Bangumi
BGM_APP_ID=your-app-id
BGM_APP_SECRET=your-app-secret
BGM_REDIRECT_URI=http://localhost:3000/auth/bgm/callback

# 同步配置
SYNC_CONCURRENCY=8
SYNC_RATE_LIMIT=100/min
