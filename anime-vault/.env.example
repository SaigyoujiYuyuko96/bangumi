# ========== 部署环境 ==========
ENV=development

# ========== 数据库配置 ==========
POSTGRES_DB=animevault
POSTGRES_USER=animevault
POSTGRES_PASSWORD=animevault
POSTGRES_PORT=5432

# ========== Redis 配置 ==========
REDIS_PORT=6379

# ========== 后端配置 ==========
BACKEND_PORT=8000
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========== OpenAI 配置 ==========
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ========== Bangumi API 配置 ==========
BGM_APP_ID=your-app-id
BGM_APP_SECRET=your-app-secret
BGM_REDIRECT_URI=http://localhost:3000/auth/bgm/callback

# ========== 同步配置 ==========
SYNC_CONCURRENCY=8
SYNC_RATE_LIMIT=100/min

# ========== 前端配置 ==========
FRONTEND_PORT=5173
VITE_API_URL=/api/v1

# ========== Nginx 配置 ==========
NGINX_PORT=80
NGINX_SSL_PORT=443
